{
  "name": "redisx",
  "version": "0.1.0",
  "description": "RedisX In-Memory Database Engine & RedisX Studio",
  "scripts": {
    "dev": "node tools/studio-dev.mjs",
    "build": "npm run gateway:build && npm run web:build",
    "typecheck": "npm --prefix studio/gateway run typecheck && npm --prefix studio/web run typecheck",
    "test:studio": "npm --prefix studio/web run test:studio",
    "verify:engine": "npm --prefix studio/gateway run verify:engine",
    "backend": "npm --prefix studio/gateway run dev",
    "frontend": "npm --prefix studio/web run dev",
    "backend:build": "npm --prefix studio/gateway run build",
    "frontend:build": "npm --prefix studio/web run build",
    "gateway:dev": "npm --prefix studio/gateway run dev",
    "gateway:build": "npm --prefix studio/gateway run build",
    "web:dev": "npm --prefix studio/web run dev",
    "web:build": "npm --prefix studio/web run build",
    "studio": "npm --prefix studio/web run dev",
    "test": "npm --prefix studio/gateway test && npm --prefix studio/web test",
    "test:gateway": "npm --prefix studio/gateway test",
    "test:web": "npm --prefix studio/web test"
  }
}
