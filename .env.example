# ==============================================================================
# RedisX Studio & Gateway Production Environment Configuration
# ==============================================================================

# Production Domain & Host
PUBLIC_DOMAIN=pbredisdb.pburls.online

# Database Engine Connection (Internal Docker network hostname)
REDIS_HOST=redisx
REDIS_PORT=6379
REDIS_PASSWORD=

# Live Production Mode (Strict Live Engine / No Demo Simulation)
NODE_ENV=production
DEMO_MODE=false
DEMO_FALLBACK=false

# API Gateway Configuration
PORT=4000
HOST=0.0.0.0
STUDIO_PLAYGROUND=false
# open: no account required; authenticated: require configured gateway accounts.
STUDIO_AUTH_MODE=open
LOG_LEVEL=info

# Security & Authentication (HS256 JWT Secret)
JWT_SECRET=redisx-prod-auth-secret-key-32chars-minimum-token-pburls

# Production Role Credentials
ADMIN_PASS=pbredis_admin_secure_pass_2026
OPERATOR_PASS=pbredis_operator_pass_2026
VIEWER_PASS=pbredis_viewer_pass_2026

# CORS Origin Policy (Production Domain + HTTPS)
CORS_ORIGIN=https://pbredisdb.pburls.online,http://13.210.234.73:3000,http://127.0.0.1:3000

# Monitoring & Prometheus Scrape
METRICS_PORT=9121
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
