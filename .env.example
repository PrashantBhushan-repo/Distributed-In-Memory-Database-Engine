# ==============================================================================
# RedisX Studio & Gateway Runtime Environment Configuration
# ==============================================================================

# Database Connection
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Demo Mode & Fallback
# Set to 'true' to force simulated in-memory mock engine (zero daemon dependency)
DEMO_MODE=false
# Automatically fall back to demo mode if Redis TCP connection is refused
DEMO_FALLBACK=true

# API Gateway Configuration
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Security & Authentication
# HS256 JWT signing secret key (minimum 32 characters in production)
JWT_SECRET=redisx-studio-super-secure-production-secret-key-32chars!

# Static User Credentials
ADMIN_PASS=admin123
OPERATOR_PASS=operator123
VIEWER_PASS=viewer123

# CORS Origin Policy (comma-separated allowed browser origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Monitoring & Prometheus Scrape
METRICS_PORT=9121
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
