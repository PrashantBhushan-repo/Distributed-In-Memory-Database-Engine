# ==============================================================================
# RedisX Studio & Gateway - LOCAL DEVELOPMENT ENVIRONMENT (.env.development)
# ==============================================================================

# Runtime Mode
NODE_ENV=development
LOG_LEVEL=debug

# Public Host (Localhost for browser navigation)
PUBLIC_DOMAIN=localhost

# Database Engine Connection (Localhost / Docker bridge)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Development Fallback (Permit mock demo fallback if C++ engine is stopped)
DEMO_MODE=false
DEMO_FALLBACK=true

# API Gateway Configuration
PORT=4000
HOST=127.0.0.1

# Development JWT Secret (Safe for local testing)
JWT_SECRET=redisx-dev-local-secret-key-32chars-min-token-dev12345

# Development User Passwords
ADMIN_PASS=admin123
OPERATOR_PASS=operator123
VIEWER_PASS=viewer123

# CORS Origin Policy (Allow local Vite/React and local tools)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000

# Observability Ports
METRICS_PORT=9121
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# Account-free local engine playground; production and remote peers still require authentication.
STUDIO_PLAYGROUND=true
