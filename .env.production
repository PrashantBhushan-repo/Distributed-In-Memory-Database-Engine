# ==============================================================================
# RedisX Studio & Gateway - PRODUCTION ENVIRONMENT (.env.production)
# ==============================================================================

# Runtime Mode
NODE_ENV=production
LOG_LEVEL=info

# Production Public Domain (HTTPS)
PUBLIC_DOMAIN=pbredisdb.pburls.online

# Database Engine Connection (Internal Docker Network hostname)
REDIS_HOST=redisx
REDIS_PORT=6379
REDIS_PASSWORD=

# Production Strictness (Never simulate, strictly use real C++ database engine)
DEMO_MODE=false
DEMO_FALLBACK=false

# API Gateway Configuration
PORT=4000
HOST=0.0.0.0

# Production JWT Secret (Minimum 32 characters, cryptographically random)
JWT_SECRET=redisx-prod-auth-secret-key-32chars-minimum-token-pburls

# Production User Passwords
ADMIN_PASS=pbredis_admin_secure_pass_2026
OPERATOR_PASS=pbredis_operator_pass_2026
VIEWER_PASS=pbredis_viewer_pass_2026

# CORS Origin Policy (Production domain + local tunnels)
CORS_ORIGIN=https://pbredisdb.pburls.online,http://13.210.234.73:3000,http://127.0.0.1:3000

# Observability Ports
METRICS_PORT=9121
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
